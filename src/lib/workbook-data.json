  "guia": {
    "instrucciones": [
      {
        "titulo": "1. Empieza por MARCAS",
        "detalle": "Confirma el rol, mercado, audiencia, propuesta y responsable de cada marca. Lo precargado refleja lo conversado; completa lo que falta."
      },
      {
        "titulo": "2. Registra el trabajo en CHECKLIST",
        "detalle": "Cada pendiente debe tener responsable, estado, fecha y evidencia. Cambia el estado; no borres tareas. Añade filas si aparece trabajo nuevo."
      },
      {
        "titulo": "3. Define el catálogo matriz",
        "detalle": "CAT_MATRIZ reúne capacidades B2B y procesos de producción que Mono Cromat puede ofrecer o coordinar."
      },
      {
        "titulo": "4. Construye el catálogo de cada marca",
        "detalle": "CAT_MARCAS contiene productos, variantes, presentación, empaque, SKU y datos comerciales. Un producto puede tener varias variantes."
      },
      {
        "titulo": "5. Costea antes de fijar precios",
        "detalle": "COSTEO calcula un precio sugerido a partir de costos variables, comisiones y margen objetivo. Completa tasas e importes reales; no copies precios de otras marcas."
      },
      {
        "titulo": "6. Separa fijos y variables",
        "detalle": "GASTOS_FIJOS registra gastos recurrentes. El costo fijo mensual no se debe confundir con el costo variable unitario."
      },
      {
        "titulo": "7. Documenta proveedores, operación y riesgos",
        "detalle": "PROVEEDORES, OPERACION y RIESGOS evitan que el conocimiento viva solamente en tu cabeza o en conversaciones."
      },
      {
        "titulo": "8. Registra decisiones",
        "detalle": "DECISIONES deja trazabilidad: qué se decidió, por qué, quién lo aprobó y qué cambia en los demás archivos."
      },
      {
        "titulo": "9. Revisa el PANEL cada semana",
        "detalle": "El panel cuenta tareas por estado. Es una fotografía de avance, no una autorización automática para lanzar."
      }
    ],
    "reglas": [
      {
        "titulo": "Una marca se evalúa por sí misma.",
        "detalle": "El público puede no conocer la casa matriz ni las otras marcas. Cada marca debe cumplir sus propios estándares."
      },
      {
        "titulo": "No se publica un producto sin costeo.",
        "detalle": "Debe existir costo unitario completo, precio revisado, margen calculado y canal de venta definido."
      },
      {
        "titulo": "No se lanza sin prototipo aprobado.",
        "detalle": "Debe revisarse físicamente el producto, su acabado, legibilidad, empaque y resistencia de uso."
      },
      {
        "titulo": "No se usa propiedad ajena sin autorización.",
        "detalle": "En especial personajes, logos, fotografías, nombres de artistas, franquicias y signos oficiales de transporte."
      },
      {
        "titulo": "No se lanza todo al mismo tiempo.",
        "detalle": "Primero un piloto controlado; mide producción, entregas, devoluciones, margen y carga de trabajo antes de escalar."
      },
      {
        "titulo": "No se marca 'Hecho' sin evidencia.",
        "detalle": "Adjunta archivo, foto, enlace, cotización, muestra aprobada o documento que demuestre el cierre."
      }
    ],
    "estados": [
      {
        "titulo": "Pendiente",
        "detalle": "No se ha comenzado."
      },
      {
        "titulo": "En curso",
        "detalle": "Alguien está trabajando activamente en ello."
      },
      {
        "titulo": "En revisión",
        "detalle": "Existe un entregable, pero falta aprobación o prueba."
      },
      {
        "titulo": "Bloqueado",
